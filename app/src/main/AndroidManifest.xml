<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- spec.md 7절: 승인된 권한만 선언한다 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />  <!-- Odometer -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" /> <!-- Fuel, EvBattery -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" /> <!-- SpeechToText (F8) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" /> <!-- TextToSpeech (F8) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 기어는 CAR_DRIVE로 읽으므로 CAR_SPEED·CAR_POWERTRAIN은 필요 없다 (V3).
         녹음은 Pleos 음성 서비스가 하므로 RECORD_AUDIO도 선언하지 않는다 (V4). -->

    <application
        android:name=".GachigaApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 주행 모드 화면을 보여 주기 위함. 필요 여부는 V5에서 확인 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
